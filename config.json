{
  "version": "3.0-spine",
  "protocol_version": 3,
  "verdict_interval_seconds": 5,
  "microgoal_default_seconds": 60,
  "microgoal_min_seconds": 20,
  "microgoal_max_seconds": 180,
  "screen_vision_interval_seconds": 20,
