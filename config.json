    "vision_models_env": "EILA_VISION_MODELS",
    "judge_models_env": "EILA_JUDGE_MODELS",
    "research_models_env": "EILA_RESEARCH_MODELS",
    "fallback_models": [
      "ollama/qwen2.5:7b"
    ],
    "vision_fallback_models": [
      "ollama/qwen2.5vl:7b"
